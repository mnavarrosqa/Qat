LLM_PROVIDER=claude-cli
CLAUDE_COMMAND=claude

JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=

XRAY_ENABLED=true
# api = create/update tests directly; export = create importable files instead.
XRAY_MODE=api
XRAY_EXPORT_FORMAT=csv
# Optional Xray Cloud API credentials. Keep real values only in .env/environment.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
# Optional: leave empty to create Tests/Test Executions in the same project as the source issue.
XRAY_PROJECT_KEY=
XRAY_TEST_ISSUE_TYPE=Test
XRAY_EXECUTION_ISSUE_TYPE=Test Execution
XRAY_LINK_TYPE=Tests
XRAY_EXECUTION_LINK_TYPE=Tests
# Optional custom field used by some Xray setups to mark Manual/Generic/Cucumber tests.
# Example: customfield_12345
XRAY_TEST_TYPE_FIELD=
XRAY_TEST_TYPE_VALUE=Manual

# Recommended: select an environment + credential profile from .qat/environments.json.
QAT_ENVIRONMENTS_FILE=.qat/environments.json
QAT_ENV=qa
QAT_PROFILE=qa-user

# Backward-compatible single-environment mode. Used only when QAT_ENVIRONMENTS_FILE does not exist.
QAT_BASE_URL=https://qa.example.com
QAT_USER=
QAT_PASSWORD=

TOKEN_BUDGET=12000

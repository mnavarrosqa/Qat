LLM_PROVIDER=claude-cli
CLAUDE_COMMAND=claude
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=

XRAY_ENABLED=true
# Optional: leave empty to create Tests in the same project as the source issue.
XRAY_PROJECT_KEY=
XRAY_TEST_ISSUE_TYPE=Test
XRAY_LINK_TYPE=Tests
# Optional custom field used by some Xray setups to mark Manual/Generic/Cucumber tests.
# Example: customfield_12345
XRAY_TEST_TYPE_FIELD=
XRAY_TEST_TYPE_VALUE=Manual

TOKEN_BUDGET=12000
